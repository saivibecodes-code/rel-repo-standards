# ==============================================================================
# Sample Production Crontab for rel-* Real Estate Intelligence Platform
# Host: Oracle Cloud Infrastructure (OCI) Ampere A1 (Ubuntu 22.04 LTS)
# Base Directory: /home/ubuntu/
# Timezone: UTC
# ==============================================================================

# Daily Ingestion Pipeline
# ------------------------------------------------------------------------------
# 1. Denton County Ingestion (Tax Assessor + Clerk Recordings)
30 06 * * * cd /home/ubuntu/rel-svc-denton-data && .venv/bin/python3 run_all.py >> logs/cron_denton.log 2>&1

# 2. Collin County Ingestion (CAD Parcels + Deeds & Liens)
00 07 * * * cd /home/ubuntu/rel-svc-collin-data && .venv/bin/python3 run_all.py >> logs/cron_collin.log 2>&1

# 3. Downstream Analytical Synthesis (Motivation Stacking & Parity Reports)
30 07 * * * /home/ubuntu/rel-repo-standards/ops/bin/run_pipeline.sh rel-aly-works >> /home/ubuntu/rel-aly-works/logs/cron_analytics.log 2>&1

# Weekly Maintenance (Sunday at 03:00 UTC)
# ------------------------------------------------------------------------------
# Vacuum and Truncate WAL files across all SQLite databases
00 03 * * 0 sqlite3 /home/ubuntu/rel-svc-denton-data/data/denton_county.db "PRAGMA wal_checkpoint(TRUNCATE); VACUUM;" >> /home/ubuntu/logs/vacuum.log 2>&1
15 03 * * 0 sqlite3 /home/ubuntu/rel-svc-collin-data/data/collin_county.db "PRAGMA wal_checkpoint(TRUNCATE); VACUUM;" >> /home/ubuntu/logs/vacuum.log 2>&1
30 03 * * 0 sqlite3 /home/ubuntu/rel-aly-works/data/distress_leads.db "PRAGMA wal_checkpoint(TRUNCATE); VACUUM;" >> /home/ubuntu/logs/vacuum.log 2>&1
