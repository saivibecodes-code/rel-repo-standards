# ==============================================================================
# Sample Production Crontab for rel-* Real Estate Intelligence Platform
# Host: Oracle Cloud Infrastructure (OCI) Ampere A1 (Ubuntu 22.04 LTS)
# Base Directory: /home/ubuntu/
# Timezone: UTC
# ==============================================================================

# Daily Ingestion Pipeline (UTC / America/Chicago 1:15 AM - 2:30 AM CDT)
# ------------------------------------------------------------------------------
# 1. Collin County Ingestion (CAD Parcels + Deeds & Liens)
15 06 * * * /usr/bin/flock -n /tmp/rel-svc-collin-data-pipeline.lock $R/run_pipeline.sh rel-svc-collin-data

# 2. Denton County Ingestion (CAD Roll + Tyler Clerk WebSocket)
30 06 * * * /usr/bin/flock -n /tmp/rel-svc-denton-data-pipeline.lock $R/run_pipeline.sh rel-svc-denton-data

# 3. MLS Listing Feed (Redfin/NTREIS Scraping & Transforms)
00 07 * * * /usr/bin/flock -n /tmp/rel-svc-mls-data-pipeline.lock $R/run_pipeline.sh rel-svc-mls-data

# 4. Downstream Analytical Synthesis (Motivation Stacking, WARN Radar & Deal Books)
30 07 * * * /usr/bin/flock -n /tmp/rel-aly-works-pipeline.lock $R/run_pipeline.sh rel-aly-works

# Weekly Maintenance (Sunday at 03:00 UTC)
# ------------------------------------------------------------------------------
# Vacuum and Truncate WAL files across all SQLite databases
00 03 * * 0 sqlite3 /home/ubuntu/rel-svc-denton-data/data/denton_county.db "PRAGMA wal_checkpoint(TRUNCATE); VACUUM;" >> /home/ubuntu/logs/vacuum.log 2>&1
15 03 * * 0 sqlite3 /home/ubuntu/rel-svc-collin-data/data/collin_county.db "PRAGMA wal_checkpoint(TRUNCATE); VACUUM;" >> /home/ubuntu/logs/vacuum.log 2>&1
30 03 * * 0 sqlite3 /home/ubuntu/rel-aly-works/data/distress_leads.db "PRAGMA wal_checkpoint(TRUNCATE); VACUUM;" >> /home/ubuntu/logs/vacuum.log 2>&1
